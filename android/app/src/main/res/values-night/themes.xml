        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#7692FF</item>
    </style>

    <style name="ApprovalDialogTheme" parent="android:style/Theme.Material.Dialog.Alert">
